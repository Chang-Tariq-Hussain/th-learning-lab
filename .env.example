# ── Admin sign-in ─────────────────────────────────────────────────────────────
# RECOMMENDED (Phase 2): individual accounts + roles via Supabase. When these two
# are set, the shared password below is ignored. Public values (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FALLBACK ONLY (Phase 1): one shared password, used only while Supabase is NOT configured.
ADMIN_PASSWORD=change-me-to-a-long-passphrase          # 12+ characters
ADMIN_SESSION_SECRET=generate-32-or-more-random-chars  # e.g. `openssl rand -base64 48`

# ── Operator scripts only (npm run db:import / db:parity / db:create-admin) ───
# DIRECT Postgres connection string (Supabase → Project settings → Database, port 5432).
# NEVER set this, or the service-role key, in the web app's environment (e.g. on Vercel).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
